# Files Docker must NOT copy into images (the build context is the repo root).
#
# Without this file, `COPY backend/ ./` in the production Dockerfile would
# bake your local .env (secrets!), your dev-only vendor/ folder and logs into
# the image, and anyone who can pull the image could read them.

**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
.git
**/node_modules
frontend/dist
backend/vendor
backend/storage/logs/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/app/public/*
backend/bootstrap/cache/*.php
backend/.phpunit.cache
backend/.phpunit.result.cache
backend/tests
docs
