# Settings for Docker Compose itself (ports, user id).
# The Laravel application has its own file: backend/.env
#
# Don't copy this file by hand: `make env` (run by `make setup`) creates
# `.env` from it and fills in UID, GID and VITE_USE_POLLING for your machine.

# Your user and group id on the host (`id -u` / `id -g`). Containers run as
# this user so the files they create belong to you.
# Typical values: WSL 1000 / 1000, macOS 501 / 20.
UID=1000
GID=1000

# Ports published on 127.0.0.1. Change them if something else already uses one.
FRONTEND_PORT=5173
API_PORT=8080
MAILPIT_PORT=8025
DB_PORT=54320

# true only when the project lives on a Windows drive mounted in WSL
# (/mnt/c/..., /mnt/j/...). Linux receives no file-change events from there,
# so Vite has to poll. On macOS and inside the WSL file system, keep false.
VITE_USE_POLLING=false
