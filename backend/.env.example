# Laravel configuration for local development with Docker.
# Copy to `.env` (make setup does it) and run `php artisan key:generate`.
#
# Never commit `.env`: in production it holds real secrets. Code reads these
# values through config/*.php files, never with env() directly. That way
# `php artisan config:cache` works in production.

APP_NAME="Lebanon Tourism"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# The address the *browser* uses. In development that is the Vite server,
# which forwards API calls to nginx. Links in e-mails are built from this.
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# "db" is the name of the Postgres service in compose.yaml. Containers reach
# each other by service name on Docker's internal network.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=lebanon_tourism
DB_USERNAME=lebanon_tourism
DB_PASSWORD=secret

# Sessions live in the database, so logging in survives container restarts.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Keep the session cookie away from JavaScript and other sites.
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Set to true in production (HTTPS only). Local development uses plain HTTP.
SESSION_SECURE_COOKIE=false

# Origins allowed to use cookie-based (session) authentication.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Every e-mail is caught by Mailpit: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@lebanon-tourism.test"
MAIL_FROM_NAME="${APP_NAME}"

# The fake payment gateway approves every card payment. A real provider
# (Stripe, ...) would get its own driver. See app/Payments.
PAYMENT_GATEWAY=fake
