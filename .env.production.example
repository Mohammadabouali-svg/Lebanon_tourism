# Example production settings, used by compose.prod.yaml as `.env.production`
# (same folder as this file). Copy it and replace EVERY placeholder.
# In a real deployment these values live in your hosting platform's secret
# store, not in a file on disk.

APP_NAME="Lebanon Tourism"
APP_ENV=production
# Generate with: docker compose run --rm php php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://tours.example.com
FRONTEND_URL=https://tours.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=lebanon_tourism
DB_USERNAME=lebanon_tourism
DB_PASSWORD=change-me-to-a-long-random-password

# Read by the Postgres container in compose.prod.yaml.
POSTGRES_DB=lebanon_tourism
POSTGRES_USER=lebanon_tourism
POSTGRES_PASSWORD=change-me-to-a-long-random-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=tours.example.com

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.your-provider.example
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@tours.example.com"
MAIL_FROM_NAME="${APP_NAME}"

PAYMENT_GATEWAY=fake
